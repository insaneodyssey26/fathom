<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_background">

    <ImageView
        android:id="@+id/widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/widget_emblem"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/widget_tradition_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_toEndOf="@id/widget_emblem"
                android:layout_toStartOf="@id/widget_actions_container"
                android:ellipsize="end"
                android:fontFamily="@font/geist"
                android:fontVariationSettings="'wght' 500"
                android:letterSpacing="0.12"
                android:maxLines="1"
                android:text="STOICISM"
                android:textColor="#9DB0CC"
                android:textSize="9.5sp" />

            <LinearLayout
                android:id="@+id/widget_actions_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_btn_info"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginEnd="2dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Toggle exegesis commentary"
                    android:padding="5dp"
                    android:src="@drawable/widget_icon_info" />

                <ImageView
                    android:id="@+id/widget_btn_bookmark"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginEnd="2dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Bookmark passage"
                    android:padding="5dp"
                    android:src="@drawable/widget_icon_bookmark" />

                <ImageView
                    android:id="@+id/widget_btn_refresh"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Refresh verse"
                    android:padding="5dp"
                    android:src="@drawable/widget_icon_refresh" />
            </LinearLayout>
        </RelativeLayout>

        <ListView
            android:id="@+id/widget_scroll_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:layout_weight="1"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:fadingEdge="vertical"
            android:fadingEdgeLength="8dp"
            android:nestedScrollingEnabled="true"
            android:requiresFadingEdge="vertical"
            android:scrollbars="none" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/widget_wordmark"
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:adjustViewBounds="true"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/widget_verse_reference"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="12dp"
                android:layout_toStartOf="@id/widget_wordmark"
                android:ellipsize="end"
                android:fontFamily="@font/geist"
                android:fontVariationSettings="'wght' 500"
                android:letterSpacing="0.10"
                android:maxLines="1"
                android:text="MEDITATIONS 5.16"
                android:textColor="#A59C8D"
                android:textSize="10sp" />
        </RelativeLayout>
    </LinearLayout>
</FrameLayout>
