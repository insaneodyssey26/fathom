<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_streak_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_background">

    <ImageView
        android:id="@+id/widget_streak_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/widget_streak_emblem"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/widget_streak_header_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="8dp"
                android:layout_toEndOf="@id/widget_streak_emblem"
                android:fontFamily="@font/geist_mono"
                android:fontVariationSettings="'wght' 500"
                android:letterSpacing="0.12"
                android:text="SANCTUARY RITUALS"
                android:textColor="#9DB0CC"
                android:textSize="9.5sp" />

            <ImageView
                android:id="@+id/widget_streak_wordmark"
                android:layout_width="wrap_content"
                android:layout_height="16dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:adjustViewBounds="true"
                android:importantForAccessibility="no" />
        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_streak_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/geist_mono"
                    android:fontVariationSettings="'wght' 600"
                    android:includeFontPadding="false"
                    android:text="7"
                    android:textColor="#F1EADD"
                    android:textSize="32sp" />

                <TextView
                    android:id="@+id/widget_streak_count_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginBottom="4dp"
                    android:fontFamily="@font/geist_mono"
                    android:fontVariationSettings="'wght' 500"
                    android:letterSpacing="0.10"
                    android:text="DAYS CONSECRATED"
                    android:textColor="#C8AA6E"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_streak_status_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:fontFamily="@font/newsreader"
                android:fontVariationSettings="'wght' 400, 'opsz' 24"
                android:maxLines="1"
                android:text="✦ Daily Contemplation Completed"
                android:textColor="#E0D6C3"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/widget_streak_dots_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_dot_0"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="●"
                    android:textColor="#C8AA6E"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/widget_dot_1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="●"
                    android:textColor="#C8AA6E"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/widget_dot_2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="●"
                    android:textColor="#C8AA6E"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/widget_dot_3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="●"
                    android:textColor="#C8AA6E"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/widget_dot_4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="●"
                    android:textColor="#C8AA6E"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/widget_dot_5"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="●"
                    android:textColor="#C8AA6E"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/widget_dot_6"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="●"
                    android:textColor="#C8AA6E"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/widget_streak_footer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/geist_mono"
            android:fontVariationSettings="'wght' 500"
            android:letterSpacing="0.08"
            android:text="TAP TO ENTER SANCTUARY JOURNAL →"
            android:textColor="#7A8B99"
            android:textSize="9sp" />
    </LinearLayout>
</FrameLayout>
