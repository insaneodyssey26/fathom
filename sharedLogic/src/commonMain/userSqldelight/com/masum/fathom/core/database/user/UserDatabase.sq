CREATE TABLE bookmark_entity (
    id TEXT NOT NULL PRIMARY KEY,
    passage_id TEXT NOT NULL UNIQUE,
    created_at_epoch_ms INTEGER NOT NULL,
    tags_csv TEXT NOT NULL
);

CREATE INDEX idx_bookmark_passage_id ON bookmark_entity(passage_id);

CREATE TABLE user_note_entity (
    id TEXT NOT NULL PRIMARY KEY,
    passage_id TEXT NOT NULL,
    content TEXT NOT NULL,
    created_at_epoch_ms INTEGER NOT NULL,
    updated_at_epoch_ms INTEGER NOT NULL
);

CREATE INDEX idx_user_note_passage_id ON user_note_entity(passage_id);

CREATE TABLE reading_record_entity (
    passage_id TEXT NOT NULL PRIMARY KEY,
    book_id TEXT NOT NULL,
    first_seen_at_epoch_ms INTEGER NOT NULL,
    last_seen_at_epoch_ms INTEGER NOT NULL,
    read_count INTEGER NOT NULL DEFAULT 1,
    is_completed INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX idx_reading_record_book_id ON reading_record_entity(book_id);

-- Bookmark Queries
insertBookmark:
INSERT OR REPLACE INTO bookmark_entity(id, passage_id, created_at_epoch_ms, tags_csv)
VALUES (?, ?, ?, ?);

deleteBookmarkByPassageId:
DELETE FROM bookmark_entity WHERE passage_id = ?;

selectAllBookmarks:
SELECT * FROM bookmark_entity ORDER BY created_at_epoch_ms DESC;

selectBookmarkByPassageId:
SELECT * FROM bookmark_entity WHERE passage_id = ?;

-- Note Queries
upsertNote:
INSERT OR REPLACE INTO user_note_entity(id, passage_id, content, created_at_epoch_ms, updated_at_epoch_ms)
VALUES (?, ?, ?, ?, ?);

deleteNoteById:
DELETE FROM user_note_entity WHERE id = ?;

selectNotesForPassage:
SELECT * FROM user_note_entity WHERE passage_id = ? ORDER BY updated_at_epoch_ms DESC;

selectAllNotes:
SELECT * FROM user_note_entity ORDER BY updated_at_epoch_ms DESC;

-- Reading Record Queries
upsertReadingRecord:
INSERT INTO reading_record_entity(passage_id, book_id, first_seen_at_epoch_ms, last_seen_at_epoch_ms, read_count, is_completed)
VALUES (?, ?, ?, ?, ?, ?)
ON CONFLICT(passage_id) DO UPDATE SET
    last_seen_at_epoch_ms = excluded.last_seen_at_epoch_ms,
    read_count = read_count + 1,
    is_completed = excluded.is_completed;

selectReadingRecordByPassageId:
SELECT * FROM reading_record_entity WHERE passage_id = ?;

selectAllReadingRecords:
SELECT * FROM reading_record_entity ORDER BY last_seen_at_epoch_ms DESC;

selectSeenPassageIds:
SELECT passage_id FROM reading_record_entity;
